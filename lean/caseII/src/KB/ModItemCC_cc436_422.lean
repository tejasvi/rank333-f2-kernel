/-! # KB.ModItemCC_cc436_422: the module-form item emitter on the CC route's table `cc436_422` (generated by py/mkmodcc.py)

The loaders of `KB.LoadItemCC_cc436_422` with every item name private (`mkPrivateName`) and every theorem added by `addDecl`, so that an
item module's records, tables, stacks, batch checks and facts stay in its `.olean.private`.  Commands: `#kmHead`, `#kmB`, `#kmEnd`,
`#kmDead` (as `#kritemHeadCC`, `#kritemB2CC`, `#kritemEndCC`, `#kditemDeadCC`, on the private item name), and
`#kmKeys thm I1 I2 …`, the module's one public theorem `thm : R22N.KeysOK checked [key1, …]` (`checked k :=
KB.CheckedRCC_cc436_422 k ∨ KB.CheckedDeadCC_cc436_422 k`) from the items' private `Ij.checked`. -/
@[expose] public section
open Lean Elab Command L1Load KBLoad KBLoadR KBLoadR2
namespace KBModCC_cc436_422

/-- a theorem through `addDecl` (module-aware; private names stay private), kernel time in ms -/
meta def thmP (n : Name) (ty pf : Expr) (what : String) : CommandElabM Nat := do
  let t0 ← IO.monoNanosNow
  try liftCoreM <| addDecl (Declaration.thmDecl { name := n, levelParams := [], type := ty, value := pf })
  catch e => throwError m!"{what}: kernel rejects: {e.toMessageData}"
  let t1 ← IO.monoNanosNow
  return (t1 - t0) / 1000000

meta def NS : Name := `KCC_cc436_422
meta def ccTabN (l : Nat) : Name := NS ++ Name.mkSimple s!"c2t_{l}"

meta def dkPairCM (u hdr : Nat) (r0 : List Nat) (pay : Expr) : Expr :=
  mkPair natTy (prodTy natTy (prodTy natTy (prodTy lnatE (prodTy lnatE (prodTy lnatE dpayTy))))) (mkConst (ccTabN u))
    (mkPair natTy (prodTy natTy (prodTy lnatE (prodTy lnatE (prodTy lnatE dpayTy)))) (mkConst (L1Load.hName "h" u))
      (mkPair natTy (prodTy lnatE (prodTy lnatE (prodTy lnatE dpayTy))) (mkRawNatLit hdr)
        (mkPair lnatE (prodTy lnatE (prodTy lnatE dpayTy)) (mlE []) (mkPair lnatE (prodTy lnatE dpayTy) (mlE [])
          (mkPair lnatE dpayTy (mlE r0) pay)))))

/-- one dead child at `q`: `(u, hdr, nV, V idx, tag, payload)`, tag 0 cut `(kind, arg, row idx)`, 1 look-ahead
`(t, nT, h2, nTL, TL, TY, nSL, SL, SY)`, 2 profile leaf `(R)` -/
meta def parseDKCM (it : Array Nat) (q0 : Nat) : CommandElabM (Expr × Nat) := do
  let mut q := q0
  let rd (q : Nat) : List Nat × Nat := let k := it[q]!; ((List.range k).map fun j => it[q + 1 + j]!, q + 1 + k)
  let u := it[q]!; let hdr := it[q+1]!; q := q + 2
  let (r0, q') := rd q; q := q'
  let tag := it[q]!; q := q + 1
  if tag == 0 then
    let pay := mkAppN (mkConst `KB.DPay.cut) #[mkRawNatLit it[q]!, mkRawNatLit it[q+1]!, mkRawNatLit it[q+2]!]
    return (dkPairCM u hdr r0 pay, q + 3)
  if tag == 2 then
    return (dkPairCM u hdr r0 (mkApp (mkConst `KB.DPay.leaf) (mkRawNatLit it[q]!)), q + 1)
  if tag == 3 then
    -- a node cut 5 / 6 as an X part: x2, x1, node rows, aggregates (NOB layout), deficit table, one child
    let T := mkTys
    let (cREPm, cREP, cDIAG) := ((← KDLoadXB.litOf `KD.REPmF), (← KDLoadXB.litOf `KD.REPF), (← KDLoadXB.litOf `KD.DIAGF))
    let (x2, q1) := rd q; let (x1, q2) := rd q1; let (nr, q3) := rd q2; q := q3
    let na := it[q]!; q := q + 1
    let mut aggs : Array Expr := #[]
    for _ in [0:na] do
      let x := it[q]!; let k := it[q+1]!
      let masks := (List.range k).map fun j => it[q + 2 + k + j]!
      let B := KDLoadXB.aggB cREPm cREP cDIAG x (← KDLoadXB.litOf (ccTabN x)) masks
      let rows := (List.range k).map fun j => it[q + 2 + j]!
      q := q + 2 + 2 * k
      aggs := aggs.push (mkPair natTy T.ta2 (mkRawNatLit x) (mkPair natTy T.ta3 (mkConst (ccTabN x)) (mkPair natTy lnatE (mkRawNatLit B) (mlE rows))))
    let (XL, q4) := rd q; q := q4
    let HP := it[q]!; let DEFP := it[q+1]!; let J := it[q+2]!; q := q + 3
    let ku := it[q+2]!; let Fu := it[q+3]!; let ncr := it[q+4]!; q := q + 5
    let cr := (List.range ncr).map fun j => it[q + j]!
    q := q + ncr
    let (tr, q', _, _) := KDLoadXB.mkXC it q
    q := q'
    let kid := mkPair natTy T.tk2 (mkRawNatLit ku) (mkPair natTy T.tk3 (mkRawNatLit Fu) (mkPair lnatE T.tk4 (mlE cr)
      (mkPair (mkConst `KD.XC) T.tk5 tr (mkPair natTy t5E (mkConst (ccTabN ku)) (KDLoadXB.tupleE (510 - ku))))))
    let pay := mkAppN (mkConst `KB.DPay.xcut) #[mlE x2, mlE x1, mlE nr, mkList T.tAgg aggs.toList, mlE XL, mkRawNatLit HP,
      mkRawNatLit DEFP, mkRawNatLit J, kid]
    return (dkPairCM u hdr r0 pay, q)
  if tag != 1 then throwError "kditem: dead-child payload tag {tag} not supported"
  let t := it[q]!; let nT := it[q+1]!; let h2 := it[q+2]!; q := q + 3
  let nTL := it[q]!; q := q + 1
  let TL := (List.range nTL).map fun j => it[q + j]!; q := q + nTL
  let TY := (List.range nTL).map fun j => it[q + j]!; q := q + nTL
  let nSL := it[q]!; q := q + 1
  let SL := (List.range nSL).map fun j => it[q + j]!; q := q + nSL
  let SY := (List.range nSL).map fun j => it[q + j]!; q := q + nSL
  let pay := mkAppN (mkConst `KB.DPay.flook) #[mkRawNatLit t, mkRawNatLit nT, mkRawNatLit h2, mlE TL, mlE TY, mlE SL, mlE SY]
  return (dkPairCM u hdr r0 pay, q)

/-- one extension datum at `q`: `(b, its, cs, dks, xm)` -/
meta def parseExtCM (it : Array Nat) (q0 : Nat) : CommandElabM (Expr × Nat) := do
  let mut q := q0
  let rd (q : Nat) : List Nat × Nat := let k := it[q]!; ((List.range k).map fun j => it[q + 1 + j]!, q + 1 + k)
  let b := it[q]!; q := q + 1
  let (its, q1) := rd q; let (cs, q2) := rd q1; q := q2
  let ndk := it[q]!; q := q + 1
  let mut dks : Array Expr := #[]
  for _ in [0:ndk] do
    let (dk, q') ← parseDKCM it q
    dks := dks.push dk; q := q'
  let xm := it[q]!; q := q + 1
  let e := mkPair natTy (prodTy lnatE (prodTy lnatE (prodTy (mkApp (mkConst `List [Level.zero]) dkTy) natTy))) (mkRawNatLit b)
    (mkPair lnatE (prodTy lnatE (prodTy (mkApp (mkConst `List [Level.zero]) dkTy) natTy)) (mlE its)
      (mkPair lnatE (prodTy (mkApp (mkConst `List [Level.zero]) dkTy) natTy) (mlE cs)
        (mkPair (mkApp (mkConst `List [Level.zero]) dkTy) natTy (mkList dkTy dks.toList) (mkRawNatLit xm))))
  return (e, q)

/-- the item's head: row table (`I.T`, its check `I.T.tab_ok` and shape `I.T.valid`), root data, key, first stack `I.s0` -/
meta def itemTableCM (I : Name) (dir : String) : CommandElabM Unit := do
  R3RTLoadTD.rttableG (I ++ `T) (dir ++ "/table_0.bin") 64 552
  let tab := mkConst (I ++ `T ++ `entry)
  let ntab := (← IO.FS.readBinFile (dir ++ "/table_0.bin")).size / 69
  let nch := (ntab + 63) / 64
  let dep := Nat.max 1 (Nat.log2 (nch - 1) + 1)
  let chunkE := mkConst (I ++ `T ++ `chunk)
  let wt ← thmP (I ++ `T ++ `tab_ok) (eqTrue (mkAppN (mkConst `R3RT.tabOKQ) #[(mkApp (mkConst `KCC.rowECC) (mkConst (NS ++ `L))), chunkE, mkRawNatLit 64,
    mkConst (I ++ `T ++ `N), mkRawNatLit nch])) rflTrue s!"{I} job table"
  let hent := mkLambda `i BinderInfo.default natTy (mkApp2 (mkConst `Eq.refl [Level.one]) natTy (mkApp tab (mkBVar 0)))
  let hch := mkLambda `q BinderInfo.default natTy (mkLambda `hq BinderInfo.default
    (mkApp2 (mkConst `LE.le [Level.zero]) natTy (mkConst `instLENat) |>.app (mkRawNatLit nch) |>.app (mkBVar 0))
    (mkAppN (mkConst `KB.guard_zero) #[mkConst (I ++ `T ++ Name.mkSimple s!"D{dep}_0"), mkRawNatLit nch, mkBVar 1, mkBVar 0]))
  let wv ← thmP (I ++ `T ++ `valid) (mkApp2 (mkConst `KB.TabVCC) (mkConst (NS ++ `L)) tab)
    (mkAppN (mkConst `KB.tabVCC_of) #[mkConst (NS ++ `L), chunkE, mkConst (I ++ `T ++ `N), mkRawNatLit nch, tab, hent, hch,
      mkApp2 (mkConst `Eq.refl [Level.one]) natTy (mkRawNatLit nch), rflTrue, mkConst (I ++ `T ++ `tab_ok)]) s!"{I} job table shape"
  logInfo m!"{I}.T: {ntab} rows, tab_ok kernel {wt} ms, shape {wv} ms"

meta def itemHeadCM (I : Name) (dir : String) (key : Nat) : CommandElabM Unit := do
  itemTableCM I dir
  let it := KDLoadXB.itemsF (← IO.FS.readBinFile (dir ++ "/head.bin"))
  if it[0]! != 1 then throwError "kditem: item format {it[0]!}"
  let l0 := it[1]!; let pend0 := it[2]!; let npl := it[3]!
  let pl := (List.range npl).map fun j => it[4 + j]!
  let q := 4 + npl
  liftCoreM <| defT (I ++ `pl) lnatE (mlE pl)
  liftCoreM <| defT (I ++ `lastP) natTy (mkRawNatLit it[q]!)
  liftCoreM <| defT (I ++ `f0) t5E (frE it[q+1]! it[q+2]! it[q+3]! it[q+4]! it[q+5]!)
  liftCoreM <| defT (I ++ `l0) natTy (mkRawNatLit l0)
  liftCoreM <| defT (I ++ `pend0) natTy (mkRawNatLit pend0)
  liftCoreM <| defT (I ++ `nb) natTy (mkRawNatLit it[q+6]!)
  liftCoreM <| defT (I ++ `key) natTy (mkRawNatLit key)
  -- the root frame's witness rows (job-table indices) and the item's external children `(S, u)`, in the key's order
  let (W, extL) := if it.size > q + 7 then
      let nW := it[q+7]!
      let W := (List.range nW).map fun j => it[q + 8 + j]!
      let nE := it[q + 8 + nW]!
      let o := q + 9 + nW
      (W, (List.range nE).map fun j => (it[o + 2 * j]!, it[o + 2 * j + 1]!))
    else ([], [])
  liftCoreM <| defT (I ++ `W) lnatE (mlE W)
  liftCoreM <| defT (I ++ `extL) lpairE (mkList (prodTy natTy natTy) (extL.map fun (S, u) => mkPair natTy natTy (mkRawNatLit S) (mkRawNatLit u)))
  let lfrTy := mkApp (mkConst `List [Level.zero]) frPTy
  liftCoreM <| defT (I ++ `s0) lfrTy (mkList frPTy [mkPair t5E natTy (mkConst (I ++ `f0)) (mkConst (I ++ `pend0))])
  logInfo m!"{I}: root depth {npl + 1}, {W.length} witness rows, {extL.length} external children"

/-- an item whose root is a dead node: table, root data, the root's record `I.dk`, `I.rootc : KD.rootChk …`,
`I.dkok : KB.dkidOK …` (from `py/kitem.py`'s `dead.bin`) -/
meta def itemDeadCM (I : Name) (dir : String) (key : Nat) : CommandElabM Unit := do
  itemTableCM I dir
  let tab := mkConst (I ++ `T ++ `entry)
  let it := KDLoadXB.itemsF (← IO.FS.readBinFile (dir ++ "/dead.bin"))
  if it[0]! != 2 then throwError "kditemDead: format {it[0]!}"
  let npl := it[2]!
  let pl := (List.range npl).map fun j => it[3 + j]!
  let q := 3 + npl
  let (S0, D0, N0, U0, d0) := (it[q+1]!, it[q+2]!, it[q+3]!, it[q+4]!, it[q+5]!)
  liftCoreM <| defT (I ++ `pl) lnatE (mlE pl)
  liftCoreM <| defT (I ++ `lastP) natTy (mkRawNatLit it[q]!)
  liftCoreM <| defT (I ++ `f0) t5E (frE S0 D0 N0 U0 d0)
  liftCoreM <| defT (I ++ `key) natTy (mkRawNatLit key)
  let nW := it[q+6]!
  let W := (List.range nW).map fun j => it[q + 7 + j]!
  liftCoreM <| defT (I ++ `W) lnatE (mlE W)
  let (dk, qe) ← parseDKCM it (q + 7 + nW)
  if qe != it.size then throwError "kditemDead: {it.size - qe} items left over"
  liftCoreM <| defT (I ++ `dk) dkTy dk
  -- the root frame: the fast check (byte popcounts, KB.PcB) is evaluated; KB.rootChkW follows by KB.rootChkWF_imp (no evaluation)
  let rfA := #[mkConst (NS ++ `c1), mkConst (NS ++ `c2T), mkConst `KI.hkT, tab,
    mkConst (I ++ `pl), mkConst (I ++ `W), mkConst (I ++ `lastP), mkConst (I ++ `f0)]
  let wr ← thmP (I ++ `rootcF) (eqTrue (mkAppN (mkConst `KB.rootChkWF) rfA)) rflTrue s!"{I} root frame"
  let _ ← thmP (I ++ `rootc) (eqTrue (mkAppN (mkConst `KB.rootChkW) rfA))
    (mkAppN (mkConst `KB.rootChkWF_imp) (rfA.push (mkConst (I ++ `rootcF)))) s!"{I} root frame (rootChkW)"
  let wd ← thmP (I ++ `dkok) (eqTrue (mkAppN (mkConst `KB.dkidOK) #[mkConst `R3RT.nperpL, mkConst (NS ++ `c2T), mkConst `KI.hkT,
    mkConst `KI.cpT, tab, mkRawNatLit S0,
    mkRawNatLit D0, mkRawNatLit N0, mkRawNatLit U0, mkRawNatLit d0, mkConst (I ++ `lastP), mkConst (I ++ `dk)])) rflTrue
    s!"{I} dead root"
  logInfo m!"{I}: dead root, root frame {wr} ms, record {wd} ms"

/-- one extension datum with the record's range start -/
meta def parseExtRCM (it : Array Nat) (q0 : Nat) : CommandElabM (Expr × Nat) := do
  let (e, q1) ← parseExtCM it q0
  return (mkPair extTy natTy e (mkRawNatLit it[q1]!), q1 + 1)

meta def extRECM (tab : Expr) : Expr := mkAppN (mkConst `KB.extIIR) #[mkConst `R3RT.nperpL, mkConst (NS ++ `c2T), mkConst `KI.hkT,
  mkConst `KI.cpT, tab]

meta def chainArgsRCM (I : Name) (tab : Expr) : Array Expr := #[extRTy, mkConst `R3RT.nperpL, mkConst (NS ++ `c2T), mkConst `KI.hkT,
  mkConst `KI.cpT, mkConst (I ++ `extL), mkConst (I ++ `lo), mkConst (I ++ `rngL), extRECM tab, mkConst `KB.accIIR,
  mkConst `KB.xkIIR, mkConst `KB.rgIIR, tab]

meta def itemHeadRCM (I : Name) (dir : String) (key : Nat) : CommandElabM Unit := do
  itemHeadCM I dir key
  let it := KDLoadXB.itemsF (← IO.FS.readBinFile (dir ++ "/head.bin"))
  let npl := it[3]!
  let q := 4 + npl
  let nW := it[q+7]!
  let nE := it[q + 8 + nW]!
  let o := q + 9 + nW + 2 * nE
  let lo := it[o]!; let nR := it[o+1]!
  let rs := (List.range nR).map fun j => (it[o + 2 + 3 * j]!, it[o + 3 + 3 * j]!, it[o + 4 + 3 * j]!)
  if o + 2 + 3 * nR != it.size then throwError "kritemHead: {it.size - (o + 2 + 3 * nR)} items left over in the head"
  liftCoreM <| defT (I ++ `lo) natTy (mkRawNatLit lo)
  liftCoreM <| defT (I ++ `rngL) lrngTy (mkList rngElTy (rs.map fun (S, l, r) =>
    mkPair (prodTy natTy natTy) natTy (mkPair natTy natTy (mkRawNatLit S) (mkRawNatLit l)) (mkRawNatLit r)))
  logInfo m!"{I}: lower bound {lo}, {nR} ranges"

/-- the end of an item with ranges: chain, root frame, final stack, root label, ranges above the bound, the key's facts -/
meta def itemEndRCM (I : Name) : CommandElabM Unit := do
  let tab := mkConst (I ++ `T ++ `entry)
  let nb ← KDLoadXB.litOf (I ++ `nb)
  let sN := mkConst (sName I nb)
  let cA := chainArgsRCM I tab
  let mut pf := mkAppN (mkConst `KD.ChainR.nil) (cA.push sN)
  for j in [0:nb] do
    let k := nb - 1 - j
    pf := mkAppN (mkConst `KD.ChainR.cons) (cA ++ #[mkConst (sName I k), mkConst (sName I (k + 1)), sN,
      mkConst (I ++ Name.mkSimple s!"n{k}"), mkConst (I ++ Name.mkSimple s!"b{k}"), pf])
  let w ← thmP (I ++ `chain) (mkAppN (mkConst `KD.ChainR) (cA ++ #[mkConst (I ++ `s0), sN])) pf s!"{I} chain"
  let lfrTy := mkApp (mkConst `List [Level.zero]) frPTy
  liftCoreM <| defT (I ++ `sN) lfrTy sN
  -- the root frame: the fast check (byte popcounts, KB.PcB) is evaluated; KB.rootChk0 follows by KB.rootChk0F_imp (no evaluation)
  let rfA := #[mkConst (NS ++ `c1), mkConst (NS ++ `c2T), mkConst `KI.hkT, tab,
    mkConst (I ++ `pl), mkConst (I ++ `W), mkConst (I ++ `lastP), mkConst (I ++ `f0)]
  let wr ← thmP (I ++ `rootF) (eqTrue (mkAppN (mkConst `KB.rootChk0F) rfA)) rflTrue s!"{I} root frame"
  let _ ← thmP (I ++ `root) (eqTrue (mkAppN (mkConst `KB.rootChk0) rfA))
    (mkAppN (mkConst `KB.rootChk0F_imp) (rfA.push (mkConst (I ++ `rootF)))) s!"{I} root frame (rootChk0)"
  let wf ← thmP (I ++ `fin) (eqTrue (mkApp (mkConst `KD.pendZ) (mkConst (I ++ `sN)))) rflTrue s!"{I} final stack"
  let wp ← thmP (I ++ `hp0) (eqTrue (mkApp2 (mkConst `Nat.beq) (mkConst (I ++ `pend0))
    (mkApp2 (mkConst `Nat.shiftLeft) (mkRawNatLit 1) (mkConst (I ++ `l0))))) rflTrue s!"{I} root label"
  let pB := mkLambda `p BinderInfo.default rngElTy (mkApp2 (mkConst `Nat.blt) (mkConst (I ++ `lo))
    (mkApp3 (mkConst `Prod.snd [Level.zero, Level.zero]) (prodTy natTy natTy) natTy (mkBVar 0)))
  let wl ← thmP (I ++ `hrl) (eqTrue (mkApp3 (mkConst `KD.allB) rngElTy pB (mkConst (I ++ `rngL)))) rflTrue
    s!"{I} ranges above the bound"
  let ofK := mkApp (mkConst `R22N.SegI.ofKey) (mkConst (I ++ `key))
  let wlo ← thmP (I ++ `hloK) (mkApp3 (mkConst `Eq [Level.one]) natTy (mkApp (mkConst `R22N.SegI.lo) ofK) (mkConst (I ++ `lo)))
    (mkApp2 (mkConst `Eq.refl [Level.one]) natTy (mkConst (I ++ `lo))) s!"{I} bound"
  let wrng ← thmP (I ++ `hrngK) (mkApp3 (mkConst `Eq [Level.one]) lrngTy (mkApp (mkConst `R22N.SegI.rng) ofK) (mkConst (I ++ `rngL)))
    (mkApp2 (mkConst `Eq.refl [Level.one]) lrngTy (mkConst (I ++ `rngL))) s!"{I} ranges"
  let wext ← thmP (I ++ `hextK) (mkApp3 (mkConst `Eq [Level.one]) lpairE (mkApp (mkConst `R22N.SegI.ext) ofK) (mkConst (I ++ `extL)))
    (mkApp2 (mkConst `Eq.refl [Level.one]) lpairE (mkConst (I ++ `extL))) s!"{I} external children"
  logInfo m!"{I}: chain {w} ms, root frame {wr} ms, final {wf} ms, root label {wp} ms, ranges {wl} ms, key bound {wlo} ms, key ranges {wrng} ms, external children {wext} ms"

meta def parseRec2CM (T : Tys) (cREPm cREP cDIAG : Nat) (it : Array Nat) (q0 : Nat) : CommandElabM (Expr × Nat) := do
  let mut q := q0
  let l := it[q]!; let hdr := it[q+1]!; q := q + 2
  let rd (q : Nat) : List Nat × Nat := let k := it[q]!; ((List.range k).map fun j => it[q + 1 + j]!, q + 1 + k)
  let (r2, q1) := rd q; let (r1, q2) := rd q1; let (r0, q3) := rd q2; let (x2, q4) := rd q3; let (x1, q5) := rd q4
  let (ks, q6) := rd q5; let (nr, q7) := rd q6
  q := q7
  let na := it[q]!; q := q + 1
  let mut aggs : Array Expr := #[]
  for _ in [0:na] do
    let x := it[q]!; let k := it[q+1]!
    let masks := (List.range k).map fun j => it[q + 2 + k + j]!
    let B := KDLoadXB.aggB cREPm cREP cDIAG x (← KDLoadXB.litOf (ccTabN x)) masks
    q := q + 2
    let rows := (List.range k).map fun j => it[q + j]!
    q := q + 2 * k
    aggs := aggs.push (mkPair natTy T.ta2 (mkRawNatLit x) (mkPair natTy T.ta3 (mkConst (ccTabN x)) (mkPair natTy lnatE (mkRawNatLit B) (mlE rows))))
  let (XL, q8) := rd q
  q := q8
  let HP := it[q]!; let DEFP := it[q+1]!; q := q + 2
  let nk := it[q]!; q := q + 1
  let mut kids : Array Expr := #[]
  for _ in [0:nk] do
    let u := it[q+2]!; let Fu := it[q+3]!; let ncr := it[q+4]!; q := q + 5
    let cr := (List.range ncr).map fun j => it[q + j]!
    q := q + ncr
    let (tr, q', _, _) := KDLoadXB2.mkXC2 it q
    q := q'
    kids := kids.push (mkPair natTy T.tk2 (mkRawNatLit u) (mkPair natTy T.tk3 (mkRawNatLit Fu) (mkPair lnatE T.tk4 (mlE cr)
      (mkPair (mkConst `KD.XC2) T.tk5 tr (mkPair natTy t5E (mkConst (ccTabN u)) (KDLoadXB.tupleE (510 - u)))))))
  let tn := T.tn
  let node := mkPair natTy tn[2]! (mkConst (ccTabN l)) (mkPair natTy tn[3]! (mkConst (L1Load.hName "h" l))
    (mkPair natTy tn[4]! (mkConst (L1Load.hName "suf" l))
    (mkPair natTy tn[5]! (mkRawNatLit hdr) (mkPair lnatE tn[6]! (mlE r2) (mkPair lnatE tn[7]! (mlE r1) (mkPair lnatE tn[8]! (mlE r0)
      (mkPair lnatE tn[9]! (mlE x2) (mkPair lnatE tn[10]! (mlE x1) (mkPair lnatE tn[11]! (mlE ks) (mkPair lnatE tn[12]! (mlE nr)
        (mkPair T.lagg tn[13]! (mkList T.tAgg aggs.toList) (mkPair lnatE tn[14]! (mlE XL) (mkPair natTy tn[15]! (mkRawNatLit HP)
          (mkPair natTy tn[16]! (mkRawNatLit DEFP) (mkPair natTy T.lkid (mkRawNatLit XL.length) (mkList T.tKid kids.toList))))))))))))))))
  return (node, q)

meta def itemBatchesR2CM (I : Name) (dir : String) (k0 k1 : Nat) : CommandElabM Nat := do
  let tab := mkConst (I ++ `T ++ `entry)
  let nb ← KDLoadXB.litOf (I ++ `nb)
  let T := mkTys
  let T2 := mkTys2
  let nodeE2 := prodTy T2.tNode extRTy
  let lnodeTy2 := mkApp (mkConst `List [Level.zero]) nodeE2
  let (cREPm, cREP, cDIAG) := ((← KDLoadXB.litOf `KD.REPmF), (← KDLoadXB.litOf `KD.REPF), (← KDLoadXB.litOf `KD.DIAGF))
  let nodeE := prodTy T.tNode extRTy
  let lnodeTy := mkApp (mkConst `List [Level.zero]) nodeE
  let lfrTy := mkApp (mkConst `List [Level.zero]) frPTy
  let mut wsum := 0
  for k in [k0:min k1 nb] do
    let it := KDLoadXB.itemsF (← IO.FS.readBinFile (batchFile dir k))
    let (st, q1) := stackAt it 0
    let mut q := q1
    if k == 0 then
      let w ← thmP (I ++ `s0_eq) (mkApp3 (mkConst `Eq [Level.one]) lfrTy (mkConst (I ++ `s0)) st)
        (mkApp2 (mkConst `Eq.refl [Level.one]) lfrTy (mkConst (I ++ `s0))) "first stack"
      wsum := wsum + w
    else if !(← getEnv).contains (sName I k) then
      liftCoreM <| defT (sName I k) lfrTy st
    let n := it[q]!; q := q + 1
    let mut recs : Array Expr := #[]
    for _ in [0:n] do
      let (x, q2) ← parseRec2CM T2 cREPm cREP cDIAG it q
      let (e, q3) ← parseExtRCM it q2
      q := q3
      recs := recs.push (mkPair T2.tNode extRTy x e)
    if q != it.size then throwError "kritem: batch {k}: {it.size - q} items left over"
    let mN := I ++ Name.mkSimple s!"m{k}"
    liftCoreM <| defT mN lnodeTy2 (mkList nodeE2 recs.toList)
    let nxt := if k + 1 < nb then batchFile dir (k + 1) else dir ++ "/fin.bin"
    let (stn, _) := stackAt (KDLoadXB.itemsF (← IO.FS.readBinFile nxt)) 0
    liftCoreM <| defT (sName I (k + 1)) lfrTy stn
    -- the kernel check on the packed records, then the unpacked batch by KD.itemXR2'_imp (no evaluation)
    let ty2 := eqTrue (mkAppN (mkConst `KD.itemXR2' []) ((chainArgsRCM I tab).push (mkConst (sName I k)) |>.push
      (mkConst mN) |>.push (mkConst (sName I (k + 1)))))
    let w ← thmP (I ++ Name.mkSimple s!"c{k}") ty2 rflTrue s!"{I} batch {k}"
    let pf := mkAppN (mkConst `KD.itemXR2'_imp []) ((chainArgsRCM I tab) ++ #[mkConst mN, mkConst (sName I k), mkConst (sName I (k + 1)),
      mkConst (I ++ Name.mkSimple s!"c{k}")])
    let pty ← liftTermElabM <| Meta.inferType pf
    -- pty = (itemXR' … s_k (List.map f m_k) s_{k+1} = true): name its record list I.n<k>, prove I.b<k>
    let some (_, lhs, _) := pty.eq? | throwError "kritemB2: unexpected type {pty}"
    let mapped := lhs.getAppArgs[14]!
    liftCoreM <| defT (I ++ Name.mkSimple s!"n{k}") lnodeTy mapped
    let ty := eqTrue (mkAppN (mkConst `KD.itemXR' []) ((chainArgsRCM I tab).push (mkConst (sName I k)) |>.push
      (mkConst (I ++ Name.mkSimple s!"n{k}")) |>.push (mkConst (sName I (k + 1)))))
    let _ ← thmP (I ++ Name.mkSimple s!"b{k}") ty pf s!"{I} batch {k} (unpacked)"
    logInfo m!"{I}.b{k}: {n} records, kernel {w} ms"
    wsum := wsum + w
  return wsum

meta def priv (n : Name) : CommandElabM Name := return mkPrivateName (← getEnv) n

elab "#kmHead " id:ident p:str key:num : command => do itemHeadRCM (← priv id.getId) p.getString key.getNat
elab "#kmB " id:ident p:str k0:num k1:num : command => do
  let w ← itemBatchesR2CM (← priv id.getId) p.getString k0.getNat k1.getNat
  logInfo m!"{id.getId}: batches {k0.getNat}..{k1.getNat}: kernel {w} ms"
elab "#kmEnd " id:ident : command => do itemEndRCM (← priv id.getId)
elab "#kmDead " id:ident p:str key:num : command => do itemDeadCM (← priv id.getId) p.getString key.getNat

/-- the module's checked predicate -/
meta def checkedE : Expr := mkLambda `k BinderInfo.default natTy
  (mkApp2 (mkConst `Or) (mkApp (mkConst `KB.CheckedRCC_cc436_422) (mkBVar 0)) (mkApp (mkConst `KB.CheckedDeadCC_cc436_422) (mkBVar 0)))

elab "#kmKeys " t:ident ids:ident* : command => do
  let env ← getEnv
  let mut keys : Array Nat := #[]
  let mut pfs : Array Expr := #[]
  for i in ids do
    let I := mkPrivateName env i.getId
    let k ← KDLoadXB.litOf (I ++ `key)
    keys := keys.push k
    let dead := env.contains (I ++ `dk)
    let ck := mkConst (I ++ `checked)
    pfs := pfs.push (if dead then
        mkApp3 (mkConst `Or.inr) (mkApp (mkConst `KB.CheckedRCC_cc436_422) (mkRawNatLit k)) (mkApp (mkConst `KB.CheckedDeadCC_cc436_422) (mkRawNatLit k)) ck
      else mkApp3 (mkConst `Or.inl) (mkApp (mkConst `KB.CheckedRCC_cc436_422) (mkRawNatLit k)) (mkApp (mkConst `KB.CheckedDeadCC_cc436_422) (mkRawNatLit k)) ck)
  -- KeysOK checked [k…] = AllL checked [k…] = checked k1 ∧ (… ∧ True)
  let P (k : Nat) : Expr := mkApp checkedE (mkRawNatLit k)
  let mut ty := mkConst `True
  let mut pf := mkConst `True.intro
  for j in [0:keys.size] do
    let jj := keys.size - 1 - j
    pf := mkApp4 (mkConst `And.intro) (P keys[jj]!) ty pfs[jj]! pf
    ty := mkApp2 (mkConst `And) (P keys[jj]!) ty
  let kl := mkList natTy (keys.toList.map mkRawNatLit)
  let stmt := mkApp2 (mkConst `R22N.KeysOK) checkedE kl
  KMod.addPub t.getId stmt pf
  logInfo m!"{t.getId}: KeysOK over {keys.size} items"
end KBModCC_cc436_422
