/-! # BranchCheck v7L with any SAT-leaf invariant, and the plane NoLift theorem (generated by `py/mksatq.py`)

`PL.checkSLQ_sound` / `PL.leafSLQ`: the soundness of the v7L node walk (`S7L.checkSL_sound`, `S7L.leafSL_pair`, copied
from `S7/SatCheck.lean` with the two carried lifts replaced by an invariant `Q`): the root moves keep `Q`
(`hmove`), the leaf test refutes `Q` at complete assignments (`hleaf`). Instance `Q = L479.LiftK n b c Em k`
(`PL.liftK_move`, `PL.liftKL_of_complete`, `PL.ltP_sound`):

* `PL.leafSLP_noLiftK`: `BC7L.leafSL (ltP pts k) R = true` gives `L479.NoLiftK (leafT R) (leafN R) (leafDom6 R) Em k`
  when `pts` lists the nonzero points of `E` without repetition. With `L479.leafNoExt_of_noLiftK` an external leaf of a
  coset IP with `k = 22 - R` inside terms is refuted for the parametric glue (`L479.LeafNoExt`), any `E`, `R`, `lo`. -/
@[expose] public section

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace PL
open BC4 BC5 BC6s BC7s S5 S6 S7 RootSound Matrix BC7T S7L
open BC6 (KB18 KBT KERV KM0 KM1 KM2 KM3 KM4 KM5 KM6 KM7 KM8 KMS LKB18 LKBT LKERV R90 R91 R92 R93 R94 R95 R96 R97 R98 RGE RK3)

theorem q_of_move {asg : Asg} {b c b' c' : Nat → Nat} (Q : (Nat → Nat) → (Nat → Nat) → Prop)
    (hmove : ∀ (b c : Nat → Nat) (p q : Nat × Nat), mul3 p.1 p.2 = 273 → mul3 q.1 q.2 = 273 → Q b c →
      Q (fun u => mul3 (mul3 (b u) p.1) q.1) (fun u => mul3 q.2 (mul3 p.2 (c u))))
    (hm : Move asg b c b' c') (h : Q b c) : Q b' c' := by
  rcases hm with ⟨rfl, rfl⟩ | ⟨_, p, q, hp, hq, rfl, rfl⟩
  · exact h
  · exact hmove b c p q hp hq h

/-- **Soundness of the node walk with SAT leaves, for any invariant `Q` of the decomposition** that the root moves keep
(`hmove`) and that the leaf test refutes at complete assignments (`hleaf`): no decomposition whose path state is
`(ACT, asg, recs)` satisfies `Q`. (`S7L.checkSL_sound` is the case of two lifts.) -/
theorem checkSLQ_sound (lt : Asg → Nat → Bool) (Q : (Nat → Nat) → (Nat → Nat) → Prop)
    (hmove : ∀ (b c : Nat → Nat) (p q : Nat × Nat), mul3 p.1 p.2 = 273 → mul3 q.1 q.2 = 273 → Q b c →
      Q (fun u => mul3 (mul3 (b u) p.1) q.1) (fun u => mul3 q.2 (mul3 p.2 (c u))))
    (T n dom need : Nat) (hn : n ≤ 31)
    (hleaf : ∀ asg w (b c : Nat → Nat), lt asg w = true → AsgOK T n b c 0 asg → Q b c → False) :
    ∀ fuel ACT asg recs S, (BC7L.checkSL lt fuel T (mkSSP T n) ACT need asg recs dom S).1 = true →
      ∀ b c, Inv T n dom b c ACT asg recs → AsgOK T n b c ACT asg → LGok n need b c → Q b c → False := by
  intro fuel
  induction fuel with
  | zero => intro ACT asg recs S h; exact absurd h Bool.false_ne_true
  | succ fuel ih =>
    intro ACT asg recs S hchk b c hinv hasg hlg hq
    rw [checkSL_succ] at hchk
    unfold nodeSL at hchk
    revert hchk
    cases hb : Nat.beq (rd 1 S) 0
    · rw [cond_false]
      cases ht31 : Nat.beq (rd 6 S) 63
      · rw [cond_false]
        show let S1 := sk 1 S
          let t := rd 5 S1
          let sym := Nat.beq (rd 1 (sk 5 S1)) 1
          let cdir := Nat.beq (rd 1 (sk 6 S1)) 1
          let ntr := rdList (rd 4 (sk 7 S1)) (sk 11 S1)
          let slr := rdList (rd 3 ntr.2) (sk 3 ntr.2)
          let nt := ntr.1
          let sl := slr.1
          let a := Nat.land (Nat.shiftRight T (Nat.mul 9 t)) 511
          let nr := mkRecs6 (mkSSP T n) ACT asg nt []
          let part := thru a recs (thru a nr.2 [])
          let allr := app recs nr.2
          let ss := mkSls6 (mkSSP T n) ACT asg sl
          let lgm := lgMask need t
          let B := andLm part (Nat.land (Nat.land ALLNZ lgm) (cond sym ORBM M512))
          let Cb := andRm part (Nat.land ALLNZ lgm)
          let cs : List (Nat × Nat) := cond cdir
            (cond (Nat.beq Cb 0) [] (cond (Nat.beq B 0) [] (candsC part ss.2 B (bitsOf Cb))))
            (cond (Nat.beq B 0) [] (candsB7 sym part ss.2 Cb (bitsOf B)))
          let ACT' := Nat.xor ACT (Nat.shiftLeft 1 t)
          let kr := @List.rec (Nat × Nat) (fun _ => Nat → Bool × Nat) (fun S => (true, S))
            (fun p _ ihc S => let r := BC7L.checkSL lt fuel T (mkSSP T n) ACT' need ((a, p.1, p.2) :: asg) (updRecs a p.1 p.2 allr) dom S
               cond r.1 (ihc r.2) (false, r.2)) cs slr.2
          (bit ACT t && ((!sym) || asg.isEmpty) && allDom dom nt && nr.1 && allDom dom sl && allThru a sl && ss.1 &&
            kr.1) = true → False
        intro S1 t sym cdir ntr slr nt sl a nr part allr ss lgm B Cb cs ACT' kr hchk
        have ha : a = aT T t := rfl
        have hcs : cs = brCands7 (mkSSP T n) ACT need asg recs t a nt sl sym cdir := rfl
        have hallr : allr = brAllr7 (mkSSP T n) ACT asg recs nt := rfl
        have hnr : nr = mkRecs6 (mkSSP T n) ACT asg nt [] := rfl
        have hss : ss = mkSls6 (mkSSP T n) ACT asg sl := rfl
        have hACT' : ACT' = ACT ^^^ 1 <<< t := rfl
        have hkr : kr = @List.rec (Nat × Nat) (fun _ => Nat → Bool × Nat) (fun S => (true, S))
            (fun p _ ihc S => let r := BC7L.checkSL lt fuel T (mkSSP T n) ACT' need ((a, p.1, p.2) :: asg) (updRecs a p.1 p.2 allr) dom S
               cond r.1 (ihc r.2) (false, r.2)) cs slr.2 := rfl
        have hnt : ∀ x ∈ nt, x < 512 := rdList_lt _ _
        have hsl : ∀ x ∈ sl, x < 512 := rdList_lt _ _
        clear_value S1 t sym cdir ntr slr nt sl a nr part allr ss lgm B Cb cs ACT' kr
        subst ha hcs hallr hnr hss hACT' hkr
        simp only [Bool.and_eq_true] at hchk
        obtain ⟨⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩, h8⟩ := hchk
        have hact : ACT.testBit t = true := by rw [← S5.bit_eq]; exact h1
        have htn : t < n := hinv.act t hact
        obtain ⟨p, hp, b', c', hinv', hlg', hpe, hmove'⟩ := br_step7_ex T n dom need (by omega) (mkSSP T n)
          (mkSSP_ok T n (by omega)) ACT asg recs t sym cdir nt sl hnt hsl h1 h2 h3 h4 h5 h6 h7 b c hinv hlg
        obtain ⟨S', hS'⟩ := kids_ok (fun p S => BC7L.checkSL lt fuel T (mkSSP T n) (ACT ^^^ 1 <<< t) need
          ((aT T t, p.1, p.2) :: asg) (updRecs (aT T t) p.1 p.2 (brAllr7 (mkSSP T n) ACT asg recs nt)) dom S) _ slr.2 h8 p hp
        have hasg' : AsgOK T n b' c' (ACT ^^^ 1 <<< t) ((aT T t, p.1, p.2) :: asg) := by
          rw [hpe]; exact asgOK_step (asgOK_move hasg hmove') t htn hact
        exact ih _ _ _ S' hS' b' c' hinv' hasg' hlg' (q_of_move Q hmove hmove' hq)
      · rw [cond_true]
        intro hchk
        have hchk' : (Nat.beq ACT 0 && lt asg (rd (rd 24 (sk 6 S)) (sk 30 S))) = true := hchk
        rw [Bool.and_eq_true] at hchk'
        obtain ⟨hA, hw⟩ := hchk'
        have hA' : ACT = 0 := Nat.eq_of_beq_eq_true hA
        subst hA'
        exact hleaf asg _ b c hw hasg hq
    · rw [cond_true]
      intro hchk
      exact over_step7 T n dom (by omega) (mkSSP T n) (mkSSP_ok T n (by omega)) ACT asg recs _
        (lt_of_lt_of_eq (rd_lt 9 _) (by norm_num)) hchk b c hinv

/-- **Leaf theorem for any invariant `Q`**: an accepted record refutes every decomposition of the record (on its domain)
that satisfies `Q`. -/
theorem leafSLQ (lt : Asg → Nat → Bool) (Q : (Nat → Nat) → (Nat → Nat) → Prop)
    (hmove : ∀ (b c : Nat → Nat) (p q : Nat × Nat), mul3 p.1 p.2 = 273 → mul3 q.1 q.2 = 273 → Q b c →
      Q (fun u => mul3 (mul3 (b u) p.1) q.1) (fun u => mul3 q.2 (mul3 p.2 (c u))))
    (R : Nat) (hleaf : ∀ asg w (b c : Nat → Nat), lt asg w = true → AsgOK (leafT R) (leafN R) b c 0 asg → Q b c → False)
    (h : BC7L.leafSL lt R = true) (b c : Nat → Nat) (hbc : BC (leafN R) b c)
    (hd : ∀ X, X < 512 → (leafDom6 R).testBit X = true →
      TX (toM3 X) = ∑ t ∈ (Finset.range (leafN R)).filter (fun t => par (aT (leafT R) t &&& X) = true),
        vecMulVec (nv (b t)) (nv (c t))) (hq : Q b c) : False := by
  rw [leafSL_eq] at h
  set R1 := sk (Nat.add 6 (Nat.mul 9 (rd 6 R))) R with hR1
  set dm := Nat.beq (rd 1 R1) 0 with hdm
  set lg := Nat.beq (rd 1 (sk 1 R1)) 1 && dm with hlg
  set RS := rkSum (leafT R) (leafN R) with hRS
  have epred : Nat.pred (Nat.shiftLeft 1 (leafN R)) = 2 ^ leafN R - 1 := by
    show 1 <<< leafN R - 1 = _; rw [Nat.one_shiftLeft]
  rw [epred] at h
  rw [Bool.and_eq_true, Nat.ble_eq, Bool.or_eq_true] at h
  obtain ⟨hn, h⟩ := h
  have hfull : lg = true → leafDom6 R = ALLNZ := by
    intro hl
    have hd' : dm = true := by rw [hlg, Bool.and_eq_true] at hl; exact hl.2
    show cond dm ALLNZ _ = ALLNZ
    rw [hd', cond_true]
  have hdfull : lg = true → ∀ X, X < 512 → ALLNZ.testBit X = true →
      TX (toM3 X) = ∑ t ∈ (Finset.range (leafN R)).filter (fun t => par (aT (leafT R) t &&& X) = true),
        vecMulVec (nv (b t)) (nv (c t)) := by
    intro hl X hX hX'
    exact hd X hX (by rw [hfull hl]; exact hX')
  rcases h with h | h
  · rw [Bool.and_eq_true, Nat.blt_eq] at h
    obtain ⟨hl', hlt'⟩ := h
    have := (lg_root (leafT R) (leafN R) b c hbc (hdfull hl')).1
    omega
  · have hlgok : LGok (leafN R) (cond lg (needP (leafT R) (leafN R) (Nat.sub RS 27)) 0) b c := by
      cases hl' : lg
      · rw [cond_false]; exact lgok_zero _ b c hbc
      · rw [cond_true]
        exact (lg_root (leafT R) (leafN R) b c hbc (hdfull hl')).2
    exact checkSLQ_sound lt Q hmove (leafT R) (leafN R) (leafDom6 R) _ hn hleaf 64 _ [] [] _ h b c
      (S5.inv_root _ _ _ b c hbc hd) (asgOK_root _ _ b c) hlgok hq

/-- **SAT leaves with `k` inside terms**: an accepted v7L record with the lifting test refutes every lift -/
theorem leafSLP_noLiftK (pts : List Nat) (k Em : Nat) (hnd : pts.Nodup)
    (hpts : ∀ p, p < 512 → p ≠ 0 → Em.testBit p = true → p ∈ pts) (R : Nat) (h : BC7L.leafSL (ltP pts k) R = true) :
    L479.NoLiftK (leafT R) (leafN R) (leafDom6 R) Em k := by
  intro b c hbc hd hl
  exact leafSLQ (ltP pts k) (fun b c => L479.LiftK (leafN R) b c Em k)
    (fun b c p q hp hq h => liftK_move (leafN R) Em k b c p q hp hq h) R
    (fun asg w b c hw hasg hq => ltP_sound pts k Em hnd hpts asg w hw (liftKL_of_complete hasg hq)) h b c hbc hd hl

